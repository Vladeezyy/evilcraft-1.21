{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contributors": ["Vladeezyy (Fabric port)"],
  "contact": {
    "homepage": "${display_url}",
    "sources": "${github_url}",
    "issues": "${issue_tracker_url}"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["org.cyclops.evilcraft.EvilCraft"]
  },
  "accessWidener": "${mod_id}.accesswidener",
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "cyclopscore": ">=${cyclopscore_version}",
    "forgeconfigapiport": "*"
  }
}
